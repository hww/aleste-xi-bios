{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Windows: Visual Studio 2022 + vcpkg",
      "description": "SDL2 from vcpkg (set VCPKG_ROOT; vcpkg install sdl2:x64-windows). Contributed by Valery (hww).",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release" }
  ]
}
