{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug alestelx (LX-DOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/emulator/build/alestelx",
            "args": ["-a", "output/LXDOS.DSK", "output/LX.ROM"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build alestelx",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
